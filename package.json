{
  "name": "taskflow",
  "productName": "Taskflow",
  "version": "0.3.0",
  "description": "Taskflow — a desktop Kanban task manager for Windows",
  "author": "Taskflow",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "build:start": "vite build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:storage": "vitest run tests/storage",
    "test:components": "vitest run tests/components",
    "test:electron": "node tests/electron/smoke.mjs",
    "test:packaged": "node tests/electron/smoke.mjs --packaged",
    "icon": "electron scripts/icon/render-icon.cjs",
    "package:win": "vite build && electron-builder --win nsis --x64",
    "release:win": "npm test && npm run package:win",
    "package:portable": "node scripts/package-portable.mjs",
    "start:packaged": "node scripts/start-packaged.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "app.taskflow.desktop",
    "productName": "Taskflow",
    "copyright": "Copyright © 2026 Taskflow",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!**/node_modules/**/*.{ts,mts,cts,map}",
      "!**/node_modules/@anthropic-ai/sdk/src/**",
      "!**/node_modules/@anthropic-ai/sdk/**/*.mjs"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taskflow",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "multiLanguageInstaller": true,
      "artifactName": "Taskflow-Setup-${version}.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
